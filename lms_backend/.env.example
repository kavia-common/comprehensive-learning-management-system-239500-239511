# PostgreSQL (provided by lms_database container / orchestration)
POSTGRES_URL=jdbc:postgresql://localhost:5432/lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms

# JWT
LMS_JWT_SECRET=replace-with-a-long-random-secret
LMS_JWT_ACCESS_TTL_SECONDS=900
LMS_JWT_REFRESH_TTL_SECONDS=1209600

# Optional CORS
LMS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional initial admin bootstrap (if set, app will create admin on startup if missing)
LMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LMS_BOOTSTRAP_ADMIN_PASSWORD=StrongPassw0rd!
LMS_BOOTSTRAP_ADMIN_NAME=Admin
